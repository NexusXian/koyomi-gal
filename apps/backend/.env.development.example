APP_ENV=development
SERVER_PORT=8080
SERVER_HOST=localhost
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
POSTGRES_HOST=HOST
POSTGRES_PORT=5432
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DATABASE=DATABASE
POSTGRES_SSL_MODE=disable
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=PASSWORD
REDIS_DATABASE=0
REDIS_TLS=false
VERIFICATION_SECRET=CHANGE_ME
VERIFICATION_CODE_TTL=5m
VERIFICATION_RESEND_INTERVAL=1m
VERIFICATION_IP_WINDOW=1h
VERIFICATION_IP_LIMIT=20
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=USERNAME
SMTP_PASSWORD=PASSWORD
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Koyomi Gal
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=30s
MAIL_QUEUE_CONCURRENCY=5
RBAC_SUPER_ADMIN_ACCOUNT=

# External import providers
# Bangumi access token is optional; anonymous requests are rate-limited more aggressively
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_API_TOKEN=

# Cloudflare R2 object storage (images)
# R2_PUBLIC_URL accepts the r2.dev subdomain in development, e.g. https://pub-<hash>.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=koyomi-gal-assets
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Age rating classification agent (Eino + OpenAI-compatible LLM)
# The agent is opt-in; keep CLASSIFICATION_AGENT_ENABLED=false to disable it.
CLASSIFICATION_AGENT_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
CLASSIFICATION_AGENT_MAX_ITERATIONS=8
CLASSIFICATION_QUEUE_CONCURRENCY=2
# Web search for evidence: "tavily" or empty (disabled). Brave/Serper/SearXNG can be added later.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
